#!/bin/sh
set -e

case "$1" in
    configure)
        # Create system user if it doesn't exist
        if ! id -u ccmdns > /dev/null 2>&1; then
            adduser \
                --system \
                --no-create-home \
                --shell /usr/sbin/nologin \
                --group \
                ccmdns
        fi

        # Add to docker group for socket access (group is created by docker install)
        if getent group docker > /dev/null 2>&1; then
            adduser ccmdns docker
        else
            echo "Warning: 'docker' group not found. Install Docker and then run: adduser ccmdns docker" >&2
        fi

        # Create log directory
        mkdir -p /var/log/ccmdns
        chown ccmdns:ccmdns /var/log/ccmdns
        chmod 750 /var/log/ccmdns
        ;;
esac

#DEBHELPER#
